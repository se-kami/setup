dirf() {
    file="${XDG_DATA_HOME}/dirs"
    chooser=fzf
    # Read the file and extract descriptions
    chosen=$(awk -F';' '{print $1}' "${file}" | $chooser --layout=reverse -i --height=10)

    # Exit if none chosen.
    [ -z "$chosen" ] && return 0

    # Get the path associated with the selected description and remove leading/trailing whitespace
    chosen=$(awk -v desc="${chosen}" -F';' '$1 == desc {print $2}' "${file}" | awk '{$1=$1};1')

    # cd into dir
    cd "${chosen}"
}

ff-merge() {
    # merge mp4 and subtitle into an mkv
    if [ $# -ne 2 ]; then
      echo "Usage: ff-merge <mp4_file> <subtitle_file>"
      return 1
    fi

    filename_base=${1%.*}
    filename_mkv="${filename_base}.mkv"

    # check file exists
    if [ -f ${filename_mkv} ] ; then
        echo "File ${filename_mkv} already exists. Exiting."
        return 1
    fi

    ffmpeg -i $1 -i $2 -c:v copy -c:a copy "${filename_mkv}"
}

