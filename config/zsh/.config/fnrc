newLatexDoc() {
    # arguments are arg1 arg2 ... argN ---> path to folder is ./arg1/...
    # name of file is argN
    newFolderPath="./"
    A=( "$@" )
    len=${#A[@]}
    let len-=1
    name="${A[-1]}"
    for (( c=0; c<=$len; c++ )) do;
        arg=${A[$c]}
        newFolderPath=$newFolderPath$arg"/"
    done
    if [[ ! -d $newFolderPath ]] ; then
        mkdir -pv $newFolderPath
    fi
    cp -riv /mnt/diskD/latex/templates/defaultTemplate.tex $newFolderPath
    cp -riv /mnt/diskD/latex/templates/latexmkrc $newFolderPath
    cd $newFolderPath
    mkdir asy
    mv defaultTemplate.tex $name".tex"
}

newLatexFolder() {
    # arguments arg1 arg2 ... ---> path to folder is ./arg1/arg2/...
    newFolderPath="./"
    for arg in "$@"; do
        newFolderPath=$newFolderPath$arg"/"
    done
    if [[ ! -d $newFolderPath ]] ; then
        mkdir -pv $newFolderPath
    fi
    cp -riv /mnt/diskD/latex/skeleton/* $newFolderPath
    cd $newFolderPath
}

