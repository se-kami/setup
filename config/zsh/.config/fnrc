extract() {
    if [ -f $1 ] ; then
        case "$1" in
            (*.tar.bz2) tar xvjf "$1" ;;
            (*.tar.gz) tar xvzf "$1" ;;
            (*.bz2) bunzip2 "$1" ;;
            (*.rar) rar x "$1" ;;
            (*.cbr) rar x -ad "$1" ;;
            (*.gz) gunzip "$1" ;;
            (*.tar) tar xvf "$1" ;;
            (*.cbt) tar xvf "$1" ;;
            (*.tbz2) tar xvjf "$1" ;;
            (*.tgz) tar xvzf "$1" ;;
            (*.zip) unzip "$1" ;;
            (*.cbz) unzip "$1" ;;
            (*.Z) uncompress "$1" ;;
            (*.7z) 7z x "$1" ;;
            (*.cb7) 7z x "$1" ;;
            (*.deb) ar vx "$1" ;;
            (*) echo "Don't know how to extract $1" ;;
        esac
    else
        echo "$1" "is not a valid file"
    fi
}

