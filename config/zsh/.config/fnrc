extract_last_bracket() {
  # Extracts the content inside the last [...] pair from each line
  if [ $# -gt 0 ]; then
    cat "$@" | sed -E 's/.*\[([^]]*)\][^[]*$/\1/'
  else
    sed -E 's/.*\[([^]]*)\][^[]*$/\1/'
  fi
}

