moveold() {
    # Check if the user provided a valid argument for days
    if [ -z "$1" ]; then
        echo "Usage: move_old_files <days>"
        return 1
    fi

    # Check if the input is a number
    if ! [[ "$1" =~ ^[0-9]+$ ]]; then
        echo "Error: Please provide a valid number of days."
        return 1
    fi

    # Check if the parent directory (..) is writable
    if [ ! -w .. ]; then
        echo "Error: Destination directory is not writable."
        return 1
    fi

    # Find and move the files modified older than $1 days
    find . -type f -mtime +$1 -exec mv -vi {} .. \;
}


